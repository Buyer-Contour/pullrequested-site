  "buyers": ["B2B startups", "AI agents"],
  "engagement_model": {
    "type": "consulting",
    "steps": ["Describe your project", "Review a free sample", "Receive a quote based on the scope of the engagement"],
    "pricing": "Free sample; account-row work is priced per accepted row. Other work is quoted separately."
  },
  "per_row_pricing": {
    "unit": "accepted_account_row",
    "currency": "USD",
    "amount_minor_per_row": 500,
    "applies_to": "Paid account-row deliverables across the listed services. Implementation and other non-row work are quoted separately.",
    "example": { "row_count": 10, "max_amount_minor": 5000 },
    "authorization": "The buyer approves the requested row count, scope, acceptance criteria and maximum total in an issued quote before payment. Submitting a request does not authorize spending."
  },
  "row_acceptance": {
    "criteria": [
      "One distinct, in-scope account per row, with every column required by the agreed quote present.",
      "Each required factual claim has a dated, accessible primary source that the buyer can check.",
      "List unverifiable claims first in the receipt; a gap in any required field makes that row unaccepted. Optional gaps do not reject a row."
    ],
    "checked_by": "buyer",
    "review_window_hours": 72,
    "review_starts_at": "Delivery of the CSV and gap-first receipt.",
    "review_expiration": "Undisputed rows that meet the criteria are accepted at the end of the review window; missing rows are never accepted.",
    "dispute": "The buyer sends the row ID and failed criterion to the quote reply thread within the review window. Phantom Pipe rechecks the cited evidence and corrects or replaces the row, or refunds it.",
    "missing_or_rejected_row": "No charge for a missing or rejected row that is not replaced with an accepted row; if prepaid, refund the per-row amount to the original payment method.",
    "sample_policy": "Free sample rows demonstrate the format only and do not count toward paid acceptance."
  },
  "quote_request": {
    "url": "https://phantompipe.com/quote",
    "method": "POST",
    "content_type": "application/x-www-form-urlencoded",
    "accept": "application/json",
    "json_body": { "content_type": "application/json", "form-name": "Optional; if supplied, must be quote." },
    "authentication": "none",
    "fields": {
      "form-name": { "required": true, "const": "quote" },
      "name": { "required": true, "type": "string", "description": "Requester name" },
      "email": { "required": true, "type": "string", "format": "email", "description": "Email address where we can reply" },
      "company": { "required": false, "type": "string", "description": "Company or agent name" },
      "service": { "required": true, "enum": ["pipeline-research", "gtm-data-ops", "outbound-systems", "gtm-automation", "not-sure"] },
      "brief": { "required": true, "type": "string", "description": "Desired outcome, tools, and scope. Do not include credentials or sensitive data." }
    },
    "response": {
      "http_status": 202,
      "content_type": "application/json",
      "request_id": "Opaque ID for the submitted request.",
      "status": "received",
      "response_window": 48,
      "response_window_unit": "hours",
      "status_url": "https://phantompipe.com/quote/status/{request_id}",
      "status_poll": { "method": "GET", "http_status": 200, "unknown_or_expired_status": 404, "receipt_retention_days": 30 },
      "notes": "The status URL confirms receipt only. The first reply is expected within the response window at the reply-to email. Submitting does not return a quote or take payment."
    }
  },
  "contact": {
    "type": "quote_form",
    "url": "https://phantompipe.com/quote",
    "email": "dane@phantompipe.com"
