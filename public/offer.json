{
  "name": "pullrequested.com",
  "url": "https://pullrequested.com/",
  "description": "Go-to-market consulting for B2B startups and AI agents.",
  "services": [
    {
      "id": "pipeline-research",
      "name": "Pipeline research",
      "deliverables": ["Ideal customer profile (ICP)", "Account and contact lists researched and enriched to your specifications"]
    },
    {
      "id": "gtm-data-ops",
      "name": "GTM data operations",
      "deliverables": ["CRM cleanup and deduplication", "Record enrichment", "Routing and scoring rules"]
    },
    {
      "id": "outbound-systems",
      "name": "Outbound systems",
      "deliverables": ["Targeting and segmentation", "Outbound sequences and copy", "Deliverability setup in the client's tools"]
    },
    {
      "id": "gtm-automation",
      "name": "GTM automation and agents",
      "deliverables": ["Custom go-to-market workflows", "Signal monitoring and research agents", "Automated handoffs"]
    }
  ],
  "buyers": ["B2B startups", "AI agents"],
  "engagement_model": {
    "type": "consulting",
    "steps": ["Describe your project", "Review a free sample", "Receive a quote based on the scope of the engagement"],
    "pricing": "Quoted per engagement"
  },
  "quote_request": {
    "url": "https://pullrequested.com/quote",
    "method": "POST",
    "content_type": "application/x-www-form-urlencoded",
    "authentication": "none",
    "fields": {
      "form-name": { "required": true, "const": "quote" },
      "name": { "required": true, "type": "string", "description": "Requester name" },
      "email": { "required": true, "type": "string", "format": "email", "description": "Email address where we can reply" },
      "company": { "required": false, "type": "string", "description": "Company or agent name" },
      "service": { "required": true, "enum": ["pipeline-research", "gtm-data-ops", "outbound-systems", "gtm-automation", "not-sure"] },
      "brief": { "required": true, "type": "string", "description": "Desired outcome, tools, and scope. Do not include credentials or sensitive data." }
    },
    "response": "The submission does not return a quote or payment link. We follow up at the reply-to email."
  },
  "contact": {
    "type": "quote_form",
    "url": "https://pullrequested.com/quote",
    "email": "dane@phantompipe.com"
  },
  "listings": [
    { "name": "Virtuals ACP", "url": "https://app.virtuals.io/acp/agent-details/01a21371-8ff8-7555-8430-ee7cca5c1c89" },
    { "name": "dealwork.ai", "url": "https://dealwork.ai/agents/39b8312e-f8c6-497f-ac65-459d6091258a" }
  ],
  "payment": "coming soon",
  "quote_payment": {
    "requires_issued_quote": true,
    "human": {
      "provider": "Stripe Checkout",
      "methods": ["card", "Link when eligible"],
      "url_template": "https://pullrequested.com/q/{signed_quote_token}"
    },
    "agent": {
      "protocol": "quote-pay-v1",
      "url_template": "https://pullrequested.com/api/pay?quote={signed_quote_token}",
      "challenge": { "method": "GET", "status": 402 },
      "payment": {
        "method": "POST",
        "content_type": "application/json",
        "required_fields": ["nonce"],
        "one_of_fields": ["payment_method", "shared_payment_token"],
        "payment_method": {
          "type": "fresh unattached Stripe card PaymentMethod ID",
          "publishable_key_path": "payment.stripe.publishable_key",
          "tokenization_url": "https://docs.stripe.com/js/payment_methods/create_payment_method"
        },
        "shared_payment_token": { "type": "Stripe SPT", "requires_preview_access": true }
      },
      "redeem": { "method": "GET", "header": "X-PAYMENT", "value": "payment_intent_id from POST response", "replay_status": 409 }
    },
    "agent_usdc": {
      "status": "pending",
      "protocol": "x402",
      "version": 2,
      "scheme": "exact",
      "network": "eip155:8453",
      "asset": "USDC",
      "url_template": "https://pullrequested.com/api/x402/pay?quote={signed_quote_token}",
      "discovery_extension": "bazaar",
      "challenge_header": "PAYMENT-REQUIRED",
      "payment_header": "PAYMENT-SIGNATURE",
      "settlement_header": "PAYMENT-RESPONSE",
      "replay_status": 409
    }
  }
}
