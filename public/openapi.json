        "summary": "Open a quote payment page or fixed-price card listing",
        "parameters": [
          {
            "name": "quote_or_product",
            "in": "path",
            "required": true,
            "description": "Signed quote token, a fixed-price service ID, or the card marketplace product ID in offer.json.",
