    "/api/checkout": {
      "parameters": [{"$ref":"#/components/parameters/SignedQuote"}, {"$ref":"#/components/parameters/Variant"}],
      "get": {
        "summary": "Redirect legacy checkout link to the quote payment page",
        "description": "Stripe Checkout is disabled. Redirects valid quotes to /q/{signed_quote_token}, which links to Tempo MPP and quote intake.",
        "responses": {
          "303": {
            "description": "Quote payment page URL.",
            "headers": {"Location":{"description":"Redirect target.", "schema":{"type":"string"}}}
          },
          "400": {"$ref":"#/components/responses/InvalidQuote"},
          "409": {
            "description": "Quote already paid or reserved for another payment.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "410": {
            "description": "Quote expired or too close to expiry for Checkout.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "422": {"$ref":"#/components/responses/MppRequired"},
          "502": {"$ref":"#/components/responses/PaymentUnavailable"},
          "503": {"$ref":"#/components/responses/PaymentUnavailable"}
        }
      },
      "post": {
        "summary": "Redirect legacy checkout link to the quote payment page",
        "description": "Stripe Checkout is disabled. Redirects valid quotes to /q/{signed_quote_token}, which links to Tempo MPP and quote intake.",
