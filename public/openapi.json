    "/quote": {
      "get": {
        "summary": "Browser quote request form",
        "responses": {"200":{"description":"Browser quote request form", "content":{"text/html":{"schema":{"type":"string"}}}}}
      },
      "head": {"summary":"Read response headers", "responses":{"200":{"description":"Browser quote request form"}}},
      "post": {
        "summary": "Submit a brief or request a quote",
        "description": "JSON requests always get a JSON receipt. For URL-encoded form requests, send Accept: application/json to get a receipt; otherwise, the submission is forwarded as a browser form. This endpoint does not issue a signed quote or take payment.",
        "parameters": [{"$ref":"#/components/parameters/Variant"}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema":{"$ref":"#/components/schemas/Brief"}},
            "application/x-www-form-urlencoded": {
              "schema": {
                "allOf": [
                  {"$ref":"#/components/schemas/Brief"},
                  {"type":"object", "properties":{"form-name":{"const":"quote"}}, "required":["form-name"]}
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request forwarded and receipt saved.",
            "headers": {"Location":{"description":"Quote request status URL.", "schema":{"type":"string"}}},
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/QuoteReceipt"}}}
          },
          "303": {
            "description": "Browser form may redirect to the thank-you page; upstream response is forwarded.",
            "headers": {"Location":{"description":"Redirect target.", "schema":{"type":"string"}}}
          },
          "400": {
            "description": "Invalid or missing intake fields.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "413": {
            "description": "JSON receipt request body exceeds 32 KiB.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "415": {
            "description": "Unsupported content type for a JSON receipt.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "502": {
            "description": "Quote intake could not confirm forwarding.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "503": {
            "description": "Forwarded, but receipt could not be saved. Contact Phantom Pipe with the request ID rather than resubmitting.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {"error":{"type":"string"}, "request_id":{"type":"string", "format":"uuid"}},
                  "required": ["error", "request_id"]
                }
              }
            }
          },
          "default": {
            "description": "Without JSON content or Accept: application/json, the response comes from the browser form intake backend."
          }
        }
      }
    },
