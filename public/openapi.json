    "/api/pay": {
      "parameters": [{"$ref":"#/components/parameters/SignedQuote"}],
      "get": {
        "summary": "Request a Stripe agent challenge or redeem a Stripe PaymentIntent",
        "parameters": [
          {
            "name": "X-PAYMENT",
            "in": "header",
            "required": false,
            "description": "Existing Stripe PaymentIntent ID from POST /api/pay. When supplied, the request redeems proof instead of returning a challenge or processing the body.",
            "schema": {"type":"string"}
          }
        ],
        "description": "Custom quote-pay-v1 protocol, not x402 or MPP. The X-PAYMENT header redeems proof; omitting it requests a challenge.",
        "responses": {
          "200": {
            "description": "Verified redemption receipt.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/PaymentReceipt"}}}
          },
          "400": {
            "description": "Invalid quote, JSON, proof, or credential.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "402": {
            "description": "quote-pay-v1 challenge when no credential is submitted, or error if proof or payment was not accepted.",
            "content": {
              "application/json": {"schema":{"oneOf":[{"$ref":"#/components/schemas/StripeChallenge"}, {"$ref":"#/components/schemas/Error"}]}}
            }
          },
          "409": {
            "description": "Already paid, reserved, or replayed.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "410": {"$ref":"#/components/responses/ExpiredQuote"},
          "422": {
            "description": "Quote requires Tempo MPP or Stripe Checkout instead.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "502": {"$ref":"#/components/responses/PaymentUnavailable"},
          "503": {"$ref":"#/components/responses/PaymentUnavailable"}
        }
      },
      "post": {
        "summary": "Pay an eligible signed quote with a Stripe credential",
        "parameters": [
          {
            "name": "X-PAYMENT",
            "in": "header",
            "required": false,
            "description": "Existing Stripe PaymentIntent ID from POST /api/pay. When supplied, the request redeems proof instead of returning a challenge or processing the body.",
            "schema": {"type":"string"}
          }
        ],
        "description": "Send the quote nonce and one eligible Stripe credential. JSON bodies over 2,048 characters are rejected. With no body or proof this returns a challenge. Never send raw card details.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {"nonce":{"type":"string"}, "shared_payment_token":{"type":"string"}, "payment_method":{"type":"string"}},
                "required": ["nonce"],
                "oneOf": [{"required":["shared_payment_token"]}, {"required":["payment_method"]}]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PaymentIntent ID after charge, or receipt when redeeming proof.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {"type":"object", "properties":{"payment_intent_id":{"type":"string"}}, "required":["payment_intent_id"]},
                    {"$ref":"#/components/schemas/PaymentReceipt"}
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid quote, JSON, proof, or credential.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "402": {
            "description": "quote-pay-v1 challenge when no credential is submitted, or error if proof or payment was not accepted.",
            "content": {
              "application/json": {"schema":{"oneOf":[{"$ref":"#/components/schemas/StripeChallenge"}, {"$ref":"#/components/schemas/Error"}]}}
            }
          },
          "409": {
            "description": "Already paid, reserved, or replayed.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "410": {"$ref":"#/components/responses/ExpiredQuote"},
          "415": {
            "description": "Payment credential body must be application/json.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "422": {
            "description": "Quote requires Tempo MPP or Stripe Checkout instead.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "502": {"$ref":"#/components/responses/PaymentUnavailable"},
          "503": {"$ref":"#/components/responses/PaymentUnavailable"}
        }
      }
    },
    "/api/mpp/pay": {
      "get": {
        "summary": "Request or settle a Tempo MPP charge",
        "description": "Use either product (discovery only) or quote (challenge/settlement). Send a wallet-generated credential only to the final signed quote URL. No x402 support.",
        "security": [{}, {"MppCredential":[]}],
        "parameters": [
          {
            "name": "quote",
            "in": "query",
            "required": false,
            "description": "Signed quote token; omit if resolving a product listing.",
            "schema": {"type":"string"}
          },
          {
            "name": "product",
            "in": "query",
            "required": false,
            "description": "MPP marketplace product ID from offer.json; omit when using the signed quote.",
            "schema": {"type":"string"}
          },
          {"$ref":"#/components/parameters/Variant"}
        ],
        "responses": {
          "200": {
            "description": "Settled payment",
            "headers": {"Payment-Receipt":{"description":"MPP payment receipt.", "schema":{"type":"string"}}},
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/PaymentReceipt"}}}
          },
          "303": {
            "description": "Product listing resolves to a fresh signed MPP quote. Retain the final URL for challenge and retry.",
            "headers": {"Location":{"description":"Redirect target.", "schema":{"type":"string"}}}
          },
          "400": {
            "description": "Invalid quote or credential, or listing called with a quote or payment credential.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "402": {
            "description": "Challenge (WWW-Authenticate) without a credential, or rejected payment. Challenge body is produced by the MPP provider.",
            "headers": {"WWW-Authenticate":{"description":"Payment challenge when requesting a charge.", "schema":{"type":"string"}}}
          },
          "404": {
            "description": "Unknown MPP product.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "409": {
            "description": "Quote already paid, reserved, or payment is a replay.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "410": {"$ref":"#/components/responses/ExpiredQuote"},
          "422": {
            "description": "Fixed-price service quote requires Tempo MPP instead.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "502": {"$ref":"#/components/responses/PaymentUnavailable"},
          "503": {"$ref":"#/components/responses/PaymentUnavailable"}
        }
      }
    },
    "/api/stripe-webhook": {
      "post": {
        "summary": "Receive signed Stripe Checkout completion events",
        "parameters": [
          {
            "name": "Stripe-Signature",
            "in": "header",
            "required": true,
            "description": "Stripe-generated signature for the original request body.",
            "schema": {"type":"string"}
          }
        ],
        "requestBody": {"required":true, "content":{"application/json":{"schema":{"type":"object"}}}},
        "responses": {
          "200": {
            "description": "Event acknowledged (unrelated events can also be acknowledged).",
            "content": {"application/json":{"schema":{"type":"object", "properties":{"received":{"const":true}}, "required":["received"]}}}
          },
          "400": {
            "description": "Invalid Stripe signature.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "502": {"$ref":"#/components/responses/PaymentUnavailable"},
          "503": {"$ref":"#/components/responses/PaymentUnavailable"}
        }
      }
    },
    "/agent-pay-test": {
      "get": {
        "summary": "Legacy Stripe agent verification page",
        "parameters": [{"$ref":"#/components/parameters/SignedQuote"}],
        "description": "Legacy route proxied to the old backend on the apex; not used by normal buyers.",
        "responses": {
          "200": {
            "description": "Verification page for the matching live verification quote.",
            "content": {"text/html":{"schema":{"type":"string"}}}
          },
          "400": {"$ref":"#/components/responses/InvalidQuote"},
          "404": {
            "description": "Verification quote not found.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "410": {"$ref":"#/components/responses/ExpiredQuote"},
          "502": {"$ref":"#/components/responses/PaymentUnavailable"},
          "503": {"$ref":"#/components/responses/PaymentUnavailable"}
        }
      }
    },
    "/api/stats/variants": {
      "get": {
        "summary": "Read aggregate UTC daily pitch-variant event counts",
        "responses": {
          "200": {
            "description": "Event totals, not unique visitors or settled payments.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "counts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "day": {"type":"string", "format":"date"},
                          "event": {"type":"string", "enum":["card_open", "mpp_challenge", "quote_request", "homepage_fetch", "offer_fetch", "llms_fetch"]},
                          "variant": {"type":"string"},
                          "count": {"type":"integer"}
                        },
                        "required": ["day", "event", "variant", "count"]
                      }
                    }
                  },
                  "required": ["counts"]
                }
              }
            }
          },
          "503": {
            "description": "Variant stats unavailable.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          }
        }
      }
    },
    "/mcp": {
      "get": {
        "summary": "Read the MCP endpoint description",
        "description": "Returns HTML for browsers and JSON otherwise. Clients requesting a server event stream with Accept: text/event-stream receive 405.",
        "responses": {
          "200": {
            "description": "Endpoint description and discovery links.",
            "content": {
              "text/html": {"schema":{"type":"string"}},
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["name", "description", "docs", "server_card"],
                  "properties": {
                    "name": {"const":"phantom-pipe"},
                    "description": {"type":"string"},
                    "docs": {"type":"string", "format":"uri-reference"},
                    "server_card": {"type":"string", "format":"uri-reference"}
                  }
                }
              }
            }
          },
          "403": {
            "description": "Origin not allowed.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/RpcResponse"}}}
          },
          "405": {"description":"No event stream; use POST.", "headers":{"Allow":{"description":"POST", "schema":{"type":"string"}}}}
        }
      },
      "post": {
        "summary": "Send a stateless MCP JSON-RPC message",
        "description": "Streamable HTTP with JSON responses only. Send Accept: application/json, text/event-stream. No session ID. Only protocol version 2025-03-26 accepts batches. Supported methods: initialize, notifications/initialized, ping, tools/list, tools/call. Quote intake is the only MCP action that sends an inquiry; no MCP tool pays or verifies settlement.",
        "parameters": [
          {
            "name": "MCP-Protocol-Version",
            "in": "header",
            "required": false,
            "description": "Negotiated protocol version. Without the header the server accepts the 2025-03-26 default.",
            "schema": {"type":"string", "enum":["2025-11-25", "2025-06-18", "2025-03-26"]}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json":{"schema":{"oneOf":[
            {"$ref":"#/components/schemas/RpcMessage"},
            {"type":"array", "minItems":1, "items":{"$ref":"#/components/schemas/RpcMessage"}}
          ]}}}
        },
        "responses": {
          "200": {
            "description": "JSON-RPC result or method/parameter error.",
            "content": {"application/json":{"schema":{"oneOf":[
              {"$ref":"#/components/schemas/RpcResponse"},
              {"type":"array", "minItems":1, "items":{"$ref":"#/components/schemas/RpcResponse"}}
            ]}}}
          },
          "202": {"description":"Notification or JSON-RPC response accepted; no response body."},
          "400": {
            "description": "Parse error, invalid envelope, or unsupported protocol-version header.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/RpcResponse"}}}
          },
          "403": {
            "description": "Origin header does not match the endpoint origin.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/RpcResponse"}}}
          },
          "406": {
            "description": "Client does not accept JSON.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/RpcResponse"}}}
          },
          "413": {
            "description": "Request body exceeds 64 KiB.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/RpcResponse"}}}
          },
          "415": {
            "description": "Content-Type must be application/json.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/RpcResponse"}}}
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "MppCredential": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Supply the full value Payment <wallet-generated credential> on the signed URL only (at most 16,384 characters). This is not a Phantom Pipe API key."
      }
    },
    "parameters": {
      "Variant": {
        "name": "v",
        "in": "query",
        "required": false,
        "description": "Optional lowercase pitch variant (1–40 letters, digits, or hyphens). Tagged discovery and payment counts are aggregate.",
        "schema": {"type":"string"}
      },
      "SignedQuote": {
        "name": "quote",
        "in": "query",
        "required": true,
        "description": "Private signed quote token issued by Phantom Pipe.",
        "schema": {"type":"string"}
      }
    },
    "responses": {
      "InvalidQuote": {
        "description": "Missing or invalid signed quote token.",
        "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
      },
      "ExpiredQuote": {"description":"Quote expired.", "content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
      "MppRequired": {
        "description": "Quote amount requires Tempo MPP instead of Stripe.",
        "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
      },
      "PaymentUnavailable": {
        "description": "Payment service or rail unavailable.",
        "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
      }
    },
    "schemas": {
      "Brief": {
        "type": "object",
        "properties": {
          "name": {"type":"string"},
          "email": {"type":"string", "format":"email"},
          "service": {"type":"string", "enum":["pipeline-research", "gtm-data-ops", "outbound-systems", "gtm-automation", "not-sure"]},
          "brief": {"type":"string"},
          "company": {"type":"string"},
          "form-name": {"const":"quote"}
        },
        "required": ["name", "email", "service", "brief"]
      },
      "QuoteReceipt": {
        "type": "object",
        "properties": {
          "request_id": {"type":"string", "format":"uuid"},
          "status": {"const":"received"},
          "response_window": {"const":48, "description":"Expected response window in hours."},
          "status_url": {"type":"string", "format":"uri"}
        },
        "required": ["request_id", "status", "response_window", "status_url"]
      },
      "Error": {"type":"object", "properties":{"error":{"type":"string"}}, "required":["error"]},
      "PaymentReceipt": {
        "type": "object",
        "properties": {
          "quote_id": {"type":"string", "format":"uuid"},
          "payment_id": {"type":"string"},
          "channel": {"type":"string", "enum":["agent", "mpp"]},
          "status": {"const":"paid"},
          "paid_at": {"type":"string", "format":"date-time"}
        },
        "required": ["quote_id", "payment_id", "channel", "status", "paid_at"]
      },
      "StripeChallenge": {
        "type": "object",
        "properties": {
          "protocol": {"const":"quote-pay-v1"},
          "quote_id": {"type":"string", "format":"uuid"},
          "amount_cents": {"type":"integer"},
          "currency": {"const":"usd"},
          "nonce": {"type":"string"},
          "expires_at": {"type":"integer", "description":"UNIX time in seconds."},
          "payment": {"type":"object"},
          "redeem": {"type":"object"}
        },
        "required": ["protocol", "quote_id", "amount_cents", "currency", "nonce", "expires_at", "payment", "redeem"]
      },
      "RpcMessage": {
        "anyOf": [
          {
            "type": "object",
            "properties": {"jsonrpc":{"const":"2.0"}, "id":{"type":["integer", "string"]}, "method":{"type":"string"}, "params":{"type":"object"}},
            "required": ["jsonrpc", "method"]
          },
          {"$ref":"#/components/schemas/RpcResponse"}
        ]
      },
      "RpcResponse": {
        "type": "object",
        "properties": {
          "jsonrpc": {"const":"2.0"},
          "id": {"type":["integer", "string", "null"]},
          "result": {"type":"object"},
          "error": {"type":"object", "properties":{"code":{"type":"integer"}, "message":{"type":"string"}}, "required":["code", "message"]}
        },
        "required": ["jsonrpc", "id"],
        "oneOf": [{"required":["result"]}, {"required":["error"]}]
      }
    }
  }
}
