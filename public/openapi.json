    "/quote/status/{request_id}": {
      "parameters": [
        {
          "name": "request_id",
          "in": "path",
          "required": true,
          "description": "Intake receipt ID from POST /quote.",
          "schema": {"type":"string", "format":"uuid"}
        }
      ],
      "get": {
        "summary": "Read a quote intake receipt",
        "responses": {
          "200": {
            "description": "Receipt is available. Does not confirm a reply, issued quote, or payment.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/QuoteReceipt"}}}
          },
          "404": {
            "description": "No receipt: invalid, unknown, or expired. Receipts expire after 30 days.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          },
          "503": {
            "description": "Receipt lookup is unavailable.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}
          }
        }
      },
      "head": {
        "summary": "Check receipt availability without a response body",
        "responses": {"200":{"description":"Available"}, "404":{"description":"Not found"}, "503":{"description":"Unavailable"}}
      }
    },
    "/q/{quote_or_product}": {
